# Copy to .env and fill in real values. Never commit .env.
# Docker Compose reads this file for ${VAR} interpolation.

# Required when DEV_MODE is false (the usual deploy). Use a long random
# string, at least 32 characters. Do not use placeholders or the development
# default. The process will refuse to start if this is missing or too weak.
JWT_SECRET=

# Postgres (required). Long random values of letters and digits only (they go
# inside database addresses, where / + = break them): `openssl rand -hex 32`.
# POSTGRES_PASSWORD is the database container's superuser, used only by the
# container itself. The app connects as curiculy_app, which cannot bypass the
# row-level security that keeps families apart; curiculy_owner runs migrations
# and backups. The roles are created on the database's first start.
POSTGRES_PASSWORD=
CURICULY_OWNER_PASSWORD=
CURICULY_APP_PASSWORD=

# Local-only. When true, JWT auth is skipped and an explicit development
# signing key is allowed if JWT_SECRET is empty. Never enable in a real family
# deploy.
DEV_MODE=false

# Optional. ISBN lookup works without it; Google Books may rate-limit more.
GOOGLE_BOOKS_API_KEY=

# Optional. Portfolio email stays disabled until username and password are set.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=portfolios@curiculy.com
MAIL_FROM_NAME=Curiculy

OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Optional. Where nightly backups go (docker compose --profile backup up -d backup).
# Point it at a different disk than ./data if you can.
BACKUP_HOST_DIR=./backups

# Optional. When a proxy or tunnel (e.g. Cloudflare Tunnel) forwards traffic
# to the published port, requests arrive from Docker's gateway address. Set
# this to that address (docker network inspect curiculy_default) so the real
# visitor address from X-Forwarded-For is used for rate limits and logs.
# Only list addresses that are your proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
